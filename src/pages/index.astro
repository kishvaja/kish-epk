---
import site from '../content/site.json';
const mixFiles = import.meta.glob('../content/mixes/*.json', { eager: true, import: 'default' });
const mixes = Object.values(mixFiles)
  .filter((mix) => mix.featured)
  .map((mix) => ({
    ...mix,
    soundcloudEmbed: mix.url?.includes('soundcloud.com')
      ? `https://w.soundcloud.com/player/?url=${encodeURIComponent(mix.url)}&color=%238b302f&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`
      : ''
  }));
import '../styles/global.css';

const email = `mailto:${site.bookingEmail}?subject=${encodeURIComponent('K!SH booking enquiry')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${site.artistName} — ${site.genres}. DJ and producer based in the UK.`} />
    <meta name="theme-color" content="#171716" />
    <title>{site.artistName} — DJ / Producer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="K!SH home">K!SH<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">ABOUT</a>
        <a href="#listen">LISTEN</a>
        <a href="#experience">EXPERIENCE</a>
        <a class="nav-cta" href={email}>BOOKING ↗</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-art" style={`background-image: linear-gradient(90deg, rgba(18,18,17,.94) 0%, rgba(18,18,17,.64) 48%, rgba(18,18,17,.2) 100%), url('${site.heroImage}');`}>
          <div class="hero-pattern" aria-hidden="true"></div>
          <div class="hero-content">
            <p class="eyebrow"><span class="eyebrow-line"></span> DJ / PRODUCER · {site.location}</p>
            <h1>{site.tagline}</h1>
            <p class="hero-genres">{site.genres}</p>
            <div class="hero-actions">
              <a class="button button-light" href="#listen">LISTEN TO K!SH <span>↗</span></a>
              <a class="text-link" href={email}>BOOKING ENQUIRIES ↗</a>
            </div>
          </div>
          <div class="hero-index">01 / ARTIST EPK</div>
        </div>
        <div class="hero-caption"><span>INDEPENDENT DJ & PRODUCER</span><span>UK · AVAILABLE FOR BOOKINGS</span></div>
      </section>

      <section class="intro section-grid" id="about">
        <div class="section-label"><span>01</span> / THE ARTIST</div>
        <div class="intro-copy">
          <p class="kicker">A DIFFERENT PERSPECTIVE ON THE DANCEFLOOR.</p>
          <h2>Rooted in heritage.<br /><em>Driven by the underground.</em></h2>
          <p class="body-copy">{site.longBio}</p>
          <a class="arrow-link" href={site.instagramUrl} target="_blank" rel="noreferrer">FOLLOW THE JOURNEY <span>↗</span></a>
        </div>
        <div class="intro-aside">
          <div class="ornament" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
          <p>{site.shortBio}</p>
          <span class="aside-note">SOUTH ASIAN INFLUENCE / GLOBAL CLUB CULTURE</span>
        </div>
      </section>

      <section class="listen-section" id="listen">
        <div class="section-topline"><span>02 / SELECTED SOUND</span><span>LISTEN · FEEL · CONNECT</span></div>
        <div class="listen-heading">
          <h2>THE SOUND<br /><em>OF K!SH.</em></h2>
          <p>Selected mixes and productions, bringing together South Asian musical identity and contemporary club sounds.</p>
        </div>
        {mixes.map((mix, index) => (
          <div class="mix-card">
            <div class="mix-art"><span>K!SH</span><small>SELECTED MIX / {String(index + 1).padStart(3, '0')}</small></div>
            <div class="mix-details">
              <p class="kicker">FEATURED DJ MIX</p>
              <h3>{mix.title}</h3>
              <p>{mix.description}</p>
              {mix.soundcloudEmbed ? (
                <iframe title={`K!SH SoundCloud player — ${mix.title}`} width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" src={mix.soundcloudEmbed}></iframe>
              ) : (
                <a class="arrow-link" href={mix.url} target="_blank" rel="noreferrer">LISTEN TO THE MIX ↗</a>
              )}
            </div>
          </div>
        ))}
        <p class="small-note">More mixes, edits and original productions coming soon.</p>
      </section>

      <section class="experience section-grid" id="experience">
        <div class="section-label"><span>03</span> / EXPERIENCE</div>
        <div class="experience-main">
          <p class="kicker">{site.experienceEyebrow}</p>
          <h2>{site.experienceHeadline}</h2>
          <p class="body-copy">From early roadshow and club performances to a renewed focus on contemporary electronic music, K!SH brings long-standing DJ experience and a fresh creative direction.</p>
          <p class="experience-placeholder">Selected event credits and performance highlights will be added here as the new chapter develops.</p>
        </div>
      </section>

      <section class="booking" id="booking">
        <div class="booking-pattern" aria-hidden="true"></div>
        <p class="kicker">04 / BOOKINGS & COLLABORATIONS</p>
        <h2>LET'S MAKE<br /><em>SOMETHING HAPPEN.</em></h2>
        <p>{site.bookingStatement}</p>
        <a class="button button-light" href={email}>GET IN TOUCH <span>↗</span></a>
        <div class="booking-email">{site.bookingEmail}</div>
      </section>
    </main>

    <footer>
      <a class="wordmark" href="#top">K!SH<span class="wordmark-dot">.</span></a>
      <span>© {new Date().getFullYear()} K!SH · DJ / PRODUCER</span>
      <div><a href={site.soundcloudUrl} target="_blank" rel="noreferrer">SOUNDCLOUD ↗</a><a href={site.instagramUrl} target="_blank" rel="noreferrer">INSTAGRAM ↗</a></div>
    </footer>
  </body>
</html>
